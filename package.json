{
  "name": "seo-blog-generator",
  "version": "0.2.0",
  "description": "Vibe-code scaffold for SEO blog generator (fetch -> extract -> outline -> generate -> safety).",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "dev:server": "ts-node src/server.ts",
    "start:server": "node dist/server.js",
    "start": "npm run start:server",
    "demo:auto": "concurrently \"npm run dev:server\" \"python3 -m http.server 8000\"",
    "demo:mock": "cross-env MOCK_MODE=true concurrently \"npm run start:server\" \"python3 -m http.server 8000\"",
    "test:heuristics": "ts-node src/tests/heuristic_test.ts"
  },
  "license": "MIT",
  "dependencies": {
    "axios": "^1.13.2",
    "body-parser": "^1.20.3",
    "cheerio": "^1.1.2",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "node-fetch": "^2.7.0",
    "playwright": "^1.56.1"
  },
  "devDependencies": {
    "@types/body-parser": "^1.19.6",
    "@types/cheerio": "^0.22.35",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/node-fetch": "^2.6.13",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "ts-node": "^10.9.2",
    "typescript": "^4.9.5"
  }
}
